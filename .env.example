# Local recomendado: sqlite (archivo en data/pitaya.db). Vercel/demo: memory sin DATABASE_URL.
# memory | sqlite | postgres | auto
STORAGE_MODE=sqlite
DATABASE_URL=sqlite:///data/pitaya.db

# Postgres opcional (docker compose up -d + uv sync --extra postgres):
# STORAGE_MODE=postgres
# DATABASE_URL=postgresql://pitaya:pitaya@localhost:5432/pitaya

CACHE_TTL_SECONDS=900
CACHE_MAX_ITEMS=256
# Relative to backend/ when using make/uv from backend; use backend/snapshot from monorepo root deploys
SNAPSHOT_DIR=snapshot
SYNC_TIMEOUT_SECONDS=2

# Training / reproducibility
PITAYA_RANDOM_SEED=42
VALUE_PER_APPROVED_CONVERSION=50.0
